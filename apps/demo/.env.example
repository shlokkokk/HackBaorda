# ShopFlow Demo App — copy to .env.local (or run: pnpm setup:demo)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=sentinel-demo-app
SENTRY_AUTH_TOKEN=

# Links chaos panel → Sentinel API (auto-filled by setup:demo)
SENTINEL_API_URL=http://localhost:3001
SENTINEL_ORG_ID=
SENTINEL_WEBHOOK_SECRET=
NEXT_PUBLIC_SENTINEL_DASHBOARD_URL=http://localhost:3000
