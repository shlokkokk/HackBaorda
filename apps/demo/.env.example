# ShopFlow Demo App — copy to .env.local (or run: pnpm setup:demo)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=chronicle-demo-app
SENTRY_AUTH_TOKEN=

# Links chaos panel → Chronicle API (auto-filled by setup:demo)
CHRONICLE_API_URL=http://localhost:3001
CHRONICLE_ORG_ID=
CHRONICLE_WEBHOOK_SECRET=
NEXT_PUBLIC_CHRONICLE_DASHBOARD_URL=http://localhost:3000
