{
  "name": "chronicle",
  "version": "1.0.0",
  "private": true,
  "description": "Chronicle — AI-Powered Incident Response Intelligence Platform",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "dev:web": "turbo dev --filter=@chronicle/web",
    "dev:api": "turbo dev --filter=@chronicle/api",
    "dev:agent": "turbo dev --filter=@chronicle/agent",
    "dev:demo": "turbo dev --filter=@chronicle/demo",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed-incidents.ts && tsx scripts/seed-runbooks.ts && tsx scripts/train-ai-demo.ts",
    "ai:train": "tsx scripts/train-ai-demo.ts",
    "setup:agent": "tsx scripts/setup-agent.ts",
    "setup:demo": "tsx scripts/setup-demo.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
