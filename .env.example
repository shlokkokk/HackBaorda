# ═══════════════════════════════════════════════════════════════
# SENTINEL — Environment Variables Template
# Copy this to .env in each service directory and fill in values
# NEVER commit actual .env files to git
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (Database + Vector Search + Real-time) ─────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ─── Auth (Clerk) ────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── AI / Memory ─────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
MEM0_API_KEY=your_mem0_api_key_here
OPENAI_API_KEY=sk-your_openai_key_here  # Optional, for embeddings fallback

# ─── Slack Bot ───────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your_signing_secret_here
SLACK_APP_TOKEN=xapp-your-app-token-here

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here

# ─── Redis (Upstash) ────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ─── UptimeRobot ────────────────────────────────────────────
UPTIMEROBOT_API_KEY=your_uptimerobot_api_key_here
UPTIMEROBOT_WEBHOOK_SECRET=your_uptimerobot_webhook_secret_here

# ─── Sentry ─────────────────────────────────────────────────
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_secret_here
SENTRY_DSN=https://your_sentry_dsn_here

# ─── App Configuration ──────────────────────────────────────
WEBHOOK_SECRET=generate_a_random_64_char_hex_string
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DEMO_APP_URL=https://your-demo-app.vercel.app
PORT=3001
NODE_ENV=development

# ─── Sentinel Agent (for sentinel-agent/) ────────────────────
SENTINEL_WEBHOOK_URL=http://localhost:3001/api/webhooks/ingest
ORG_ID=your_org_uuid_here
CHECK_INTERVAL_MS=10000
BASELINE_WINDOW_HOURS=24
SIGMA_THRESHOLD=3.0
ALERT_COOLDOWN_MS=600000
BATCH_SIZE=50
BATCH_INTERVAL_MS=30000
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_MS=60000
HEARTBEAT_INTERVAL_MS=30000
MAX_QUEUE_SIZE=1000
RETRY_MAX_AGE_MS=86400000
DISABLED_COLLECTORS=
CUSTOM_CHECKS=[]
HOSTNAME_OVERRIDE=
LOG_LEVEL=info
DATA_DIR=./.sentinel-agent
